{
  "name": "talento-sin-clave",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter @talento/shared build && pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm --filter @talento/shared build && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter api test:e2e",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed",
    "db:seed:dev": "pnpm --filter api prisma:seed:dev"
  },

  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0"
}
