{
  "name": "talento",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter @talento/shared build && pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm --filter @talento/shared build && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm --filter @talento/shared build && pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter api test:integration",
    "test:e2e": "pnpm --filter api test:e2e",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker-compose.yml logs -f",
    "infra:prod:up": "docker compose -f infrastructure/docker-compose.prod.yml --env-file infrastructure/.env.prod up -d --build",
    "infra:prod:down": "docker compose -f infrastructure/docker-compose.prod.yml --env-file infrastructure/.env.prod down",
    "infra:prod:migrate": "docker compose -f infrastructure/docker-compose.prod.yml --env-file infrastructure/.env.prod run --rm migrate",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter api prisma:migrate:deploy",
    "db:seed": "pnpm --filter api prisma:seed",
    "db:seed:dev": "pnpm --filter api prisma:seed:dev",
    "db:seed:qa": "pnpm --filter api prisma:seed:qa",
    "db:backup": "bash scripts/backup-postgres.sh",
    "db:restore": "bash scripts/restore-postgres.sh"
  },

  "engines": {
    "node": ">=20 <25"
  },
  "packageManager": "pnpm@11.20.0"
}
