# Copy to infrastructure/.env.prod and fill values.
# NEVER commit .env.prod.
# Production CD (scripts/deploy-prod.sh) exports IMAGE_TAG=<git-sha> and overrides this.

IMAGE_TAG=local

POSTGRES_USER=talento
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=talento
# Host port only used with --profile db-host
POSTGRES_HOST_PORT=5434

# Must use Docker DNS hostname "postgres" inside the compose network.
DATABASE_URL=postgresql://talento:replace-with-strong-password@postgres:5432/talento?schema=public

# ≥32 chars, distinct, never reuse DEV secrets.
JWT_ACCESS_SECRET=replace-with-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Browser origin(s) of the web app (comma-separated). No wildcards.
CORS_ORIGINS=http://localhost:3000

# Cross-origin SPA (web:3000 → api:3001): SameSite=none + Secure.
# Same-origin reverse proxy (/api): prefer COOKIE_SAMESITE=lax and path still /auth.
COOKIE_SAMESITE=none
COOKIE_SECURE=true
TRUST_PROXY=1

# Observability
LOG_LEVEL=info
LOG_FORMAT=json
SLOW_REQUEST_MS=1000
METRICS_ENABLED=true

API_HOST_PORT=3001
WEB_HOST_PORT=3000

# Baked into the web image at build time (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STT_LANGUAGE=es-CO
