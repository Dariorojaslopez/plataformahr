# Staging example — copy to infrastructure/.env.staging (NEVER commit).
# Uses the same compose file as production-like: docker-compose.prod.yml
# Fill with staging-only secrets. Do NOT reuse production values.

IMAGE_TAG=staging

POSTGRES_USER=talento_staging
POSTGRES_PASSWORD=replace-with-staging-db-password
POSTGRES_DB=talento_staging
POSTGRES_HOST_PORT=5435

DATABASE_URL=postgresql://talento_staging:replace-with-staging-db-password@postgres:5432/talento_staging?schema=public

JWT_ACCESS_SECRET=replace-with-staging-access-secret-min-32
JWT_REFRESH_SECRET=replace-with-staging-refresh-secret-min-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Exact staging web origin(s). No wildcards.
CORS_ORIGINS=https://staging.example.com

COOKIE_SAMESITE=none
COOKIE_SECURE=true
# Direct API host: /auth. Same-origin /api proxy: /api/auth
COOKIE_PATH=/auth
TRUST_PROXY=1

LOG_LEVEL=info
LOG_FORMAT=json
SLOW_REQUEST_MS=1000
METRICS_ENABLED=true

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

API_HOST_PORT=3001
WEB_HOST_PORT=3000

# Baked into the web image at build time.
NEXT_PUBLIC_API_URL=https://api.staging.example.com
NEXT_PUBLIC_STT_LANGUAGE=es-CO

COMPANY_UPLOADS_DIR=/data/company-uploads

# Do NOT set DEV_OWNER_* / DEV_ADMIN_* in real staging with shared users.
