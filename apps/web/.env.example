# DEV
NEXT_PUBLIC_API_URL=http://localhost:3001
# Browser STT language (BCP-47). Default es-CO.
NEXT_PUBLIC_STT_LANGUAGE=es-CO

# PRODUCTION
# NEXT_PUBLIC_* is inlined at `next build` / Docker image build.
# Rebuild the web image when the public API URL changes.
# Example: NEXT_PUBLIC_API_URL=https://api.example.com
