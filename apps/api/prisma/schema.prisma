generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  BLOCKED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Language {
  ES
  EN
  PT
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum RoleScope {
  PLATFORM
  COMPANY
}

enum PlatformModule {
  ORGANIZATION
  ATS
  PERFORMANCE
  GOALS
  SETTINGS
  PREMIUM
  DEVELOPMENT
  TRAINING
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

/// Global identity. Platform owners do not require a company membership.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String?
  firstName          String
  lastName           String
  status             UserStatus @default(INVITED)
  isPlatformOwner    Boolean    @default(false)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  memberships                     CompanyMembership[]
  sessions                        UserSession[]
  auditLogs                       AuditLog[]
  employees                       Employee[]
  vacancyApprovalsDecided         VacancyApproval[]
  applicationStageHistories       ApplicationStageHistory[]
  interviewAnswers                InterviewAnswer[]
  interviewTranscriptSegments     InterviewTranscriptSegment[]
  jobOffersCreated                JobOffer[]
  hiringsCompleted                Hiring[]
  performanceCyclesCreated        PerformanceCycle[]
  performanceResultsReleased      PerformanceResult[]          @relation("PerformanceResultReleasedBy")
  goalCyclesCreated               GoalCycle[]
  goalsCreated                    Goal[]
  goalCheckInsCreated             GoalCheckIn[]
  goalCompletionRequestsRequested GoalCompletionRequest[]      @relation("GoalCompletionRequestedBy")
  goalCompletionRequestsReviewed  GoalCompletionRequest[]      @relation("GoalCompletionReviewedBy")
  goalResultsRequested            GoalResult[]                 @relation("GoalResultRequestedBy")
  goalResultsApproved             GoalResult[]                 @relation("GoalResultApprovedBy")
  calibrationPlacementsMoved      CalibrationPlacement[]

  @@map("users")
}

/// Persistent auth session. Only the refresh token hash is stored.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?
  ipAddress        String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

/// Tenant root. Business entities must scope by companyId.
model Company {
  id                     String        @id @default(uuid()) @db.Uuid
  name                   String
  legalName              String?
  slug                   String        @unique
  status                 CompanyStatus @default(ACTIVE)
  defaultLanguage        Language      @default(ES)
  brandPrimaryColor      String?
  logoFileName           String?
  logoMimeType           String?
  logoUpdatedAt          DateTime?
  /// When false, COMPANY goals stay at company level and do not apply to every employee.
  goalsCascadeEnabled    Boolean       @default(false)
  /// When false, collaborators do not see the 9Box on Mis resultados.
  showNineBoxOnMyResults Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?

  memberships                       CompanyMembership[]
  modules                           CompanyModule[]
  features                          CompanyFeature[]
  auditLogs                         AuditLog[]
  businessUnits                     BusinessUnit[]
  areas                             Area[]
  jobLevels                         JobLevel[]
  jobLevelCompetencies              JobLevelCompetency[]
  positions                         Position[]
  positionCustomFieldDefinitions    PositionCustomFieldDefinition[]
  positionCustomFieldOptions        PositionCustomFieldOption[]
  positionCustomFieldValues         PositionCustomFieldValue[]
  employeeCustomFieldValues         EmployeeCustomFieldValue[]
  employees                         Employee[]
  reportingLines                    EmployeeReportingLine[]
  vacancyRequests                   VacancyRequest[]
  vacancyApprovals                  VacancyApproval[]
  vacancyApprovalWorkflow           VacancyApprovalWorkflow?
  vacancyApprovalWorkflowSteps      VacancyApprovalWorkflowStep[]
  vacancyEvaluatorDefaults          VacancyEvaluatorDefault[]
  vacancyRequestEvaluators          VacancyRequestEvaluator[]
  vacancyRequestApprovalPlanSteps   VacancyRequestApprovalPlanStep[]
  vacancies                         Vacancy[]
  candidates                        Candidate[]
  applications                      Application[]
  applicationStageHistories         ApplicationStageHistory[]
  interviews                        Interview[]
  interviewFormTemplates            InterviewFormTemplate[]
  interviewFormQuestions            InterviewFormQuestion[]
  interviewQuestions                InterviewQuestion[]
  interviewAnswers                  InterviewAnswer[]
  interviewTranscriptSegments       InterviewTranscriptSegment[]
  jobOffers                         JobOffer[]
  hirings                           Hiring[]
  performanceCycles                 PerformanceCycle[]
  performanceCycleFollowUps         PerformanceCycleFollowUp[]
  competencies                      Competency[]
  competencyScales                  CompetencyScale[]
  competencyScaleLevels             CompetencyScaleLevel[]
  performanceCycleCompetencies      PerformanceCycleCompetency[]
  performanceCycleParticipants      PerformanceCycleParticipant[]
  performanceEvaluations            PerformanceEvaluation[]
  performanceEvaluationCompetencies PerformanceEvaluationCompetency[]
  performanceEvaluationScaleLevels  PerformanceEvaluationScaleLevel[]
  performanceEvaluationResponses    PerformanceEvaluationResponse[]
  performanceResults                PerformanceResult[]
  performanceResultGoals            PerformanceResultGoal[]
  goalCycles                        GoalCycle[]
  goals                             Goal[]
  goalAssignments                   GoalAssignment[]
  goalKeyResults                    GoalKeyResult[]
  goalCheckIns                      GoalCheckIn[]
  goalCompletionRequests            GoalCompletionRequest[]
  goalResults                       GoalResult[]
  goalResultKeyResults              GoalResultKeyResult[]
  goalResultApplicableEmployees     GoalResultApplicableEmployee[]
  homeInfo                          CompanyHomeInfo?
  billing                           CompanyBilling?
  calibrationSessions               CalibrationSession[]
  performanceGoalDefinitions        PerformanceGoalDefinition[]
  individualDevelopmentPlans        PerformanceIndividualDevelopmentPlan[]
  goalModificationRequests          PerformanceGoalModificationRequest[]
  performanceNotifications          PerformanceNotification[]
  closingSessions                   PerformanceClosingSession[]
  goalRatings                       PerformanceGoalRating[]
  calibrationPlacements             CalibrationPlacement[]

  @@map("companies")
}

enum CompanyHomeMediaKind {
  IMAGE
  VIDEO
}

/// Single HOME communication slot per company (image or video + schedule).
model CompanyHomeInfo {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @unique @db.Uuid
  title          String
  description    String                @default("")
  publishedAt    DateTime
  unpublishedAt  DateTime?
  mediaKind      CompanyHomeMediaKind?
  fileName       String?
  mimeType       String?
  mediaUpdatedAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("company_home_infos")
}

/// Platform billing inputs per company. Charged amount and net profit are calculated.
model CompanyBilling {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @unique @db.Uuid
  taxAmount          Decimal  @default(0) @db.Decimal(14, 2)
  licenseAmount      Decimal  @default(0) @db.Decimal(14, 2)
  subscriptionAmount Decimal  @default(0) @db.Decimal(14, 2)
  marginPercent      Decimal  @default(0) @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("company_billings")
}

/// User <-> Company membership. Users never store companyId directly.
model CompanyMembership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  companyId String           @db.Uuid
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  roles   MembershipRole[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String
  name        String
  description String?
  scope       RoleScope
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  membershipRoles MembershipRole[]
  permissions     RolePermission[]

  @@unique([scope, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model MembershipRole {
  membershipId String   @db.Uuid
  roleId       String   @db.Uuid
  createdAt    DateTime @default(now())

  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Tenant modules
// ---------------------------------------------------------------------------

model CompanyModule {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  module    PlatformModule
  enabled   Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, module])
  @@map("company_modules")
}

model CompanyFeature {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  feature   String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, feature])
  @@index([companyId])
  @@map("company_features")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-oriented audit trail. companyId is nullable for platform-level actions.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Organization
// ---------------------------------------------------------------------------

enum OrganizationEntityStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ReportingLineType {
  DIRECT
  INDIRECT
}

enum PositionCustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
}

enum CustomFieldAppliesTo {
  POSITION
  EMPLOYEE
}

model BusinessUnit {
  id          String                   @id @default(uuid()) @db.Uuid
  companyId   String                   @db.Uuid
  name        String
  code        String?
  description String?
  status      OrganizationEntityStatus @default(ACTIVE)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  areas     Area[]
  employees Employee[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@map("business_units")
}

model Area {
  id             String                   @id @default(uuid()) @db.Uuid
  companyId      String                   @db.Uuid
  businessUnitId String?                  @db.Uuid
  parentAreaId   String?                  @db.Uuid
  name           String
  code           String?
  description    String?
  status         OrganizationEntityStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  businessUnit    BusinessUnit?    @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  parentArea      Area?            @relation("AreaHierarchy", fields: [parentAreaId], references: [id], onDelete: Restrict)
  childAreas      Area[]           @relation("AreaHierarchy")
  positions       Position[]
  employees       Employee[]
  vacancyRequests VacancyRequest[]
  vacancies       Vacancy[]
  goals           Goal[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([businessUnitId])
  @@index([parentAreaId])
  @@map("areas")
}

model JobLevel {
  id        String                   @id @default(uuid()) @db.Uuid
  companyId String                   @db.Uuid
  name      String
  code      String?
  rank      Int
  status    OrganizationEntityStatus @default(ACTIVE)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  deletedAt DateTime?

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  positions       Position[]
  vacancyRequests VacancyRequest[]
  competencies    JobLevelCompetency[]

  @@unique([companyId, name])
  @@unique([companyId, rank])
  @@unique([companyId, code])
  @@index([companyId])
  @@map("job_levels")
}

/// Tenant-scoped assignment of catalog competencies to a job level.
/// Live configuration only — Performance evaluations snapshot cycle competencies separately.
model JobLevelCompetency {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  jobLevelId   String   @db.Uuid
  competencyId String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  jobLevel   JobLevel   @relation(fields: [jobLevelId], references: [id], onDelete: Restrict)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@unique([jobLevelId, competencyId])
  @@index([companyId])
  @@index([jobLevelId])
  @@index([competencyId])
  @@map("job_level_competencies")
}

model Position {
  id                 String                   @id @default(uuid()) @db.Uuid
  companyId          String                   @db.Uuid
  areaId             String                   @db.Uuid
  jobLevelId         String?                  @db.Uuid
  name               String
  code               String?
  mission            String?
  responsibilities   String?
  requiredExperience String?
  requiredEducation  String?
  headcount          Int                      @default(1)
  parentPositionId   String?                  @db.Uuid
  status             OrganizationEntityStatus @default(ACTIVE)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?

  company                         Company                          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  area                            Area                             @relation(fields: [areaId], references: [id], onDelete: Restrict)
  jobLevel                        JobLevel?                        @relation(fields: [jobLevelId], references: [id], onDelete: Restrict)
  parentPosition                  Position?                        @relation("PositionReportsTo", fields: [parentPositionId], references: [id], onDelete: Restrict)
  childPositions                  Position[]                       @relation("PositionReportsTo")
  employees                       Employee[]
  vacancyRequests                 VacancyRequest[]
  vacancyApprovalWorkflowSteps    VacancyApprovalWorkflowStep[]
  vacancyApprovals                VacancyApproval[]
  vacancyEvaluatorDefaults        VacancyEvaluatorDefault[]
  vacancyRequestEvaluators        VacancyRequestEvaluator[]
  vacancyRequestApprovalPlanSteps VacancyRequestApprovalPlanStep[]
  vacancies                       Vacancy[]
  customFieldValues               PositionCustomFieldValue[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([areaId])
  @@index([jobLevelId])
  @@index([parentPositionId])
  @@map("positions")
}

/// Company-scoped field definition for Position or Employee. Not hardcoded catalog fields.
model PositionCustomFieldDefinition {
  id        String                  @id @default(uuid()) @db.Uuid
  companyId String                  @db.Uuid
  key       String
  label     String
  type      PositionCustomFieldType
  appliesTo CustomFieldAppliesTo    @default(POSITION)
  required  Boolean                 @default(false)
  active    Boolean                 @default(true)
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  company        Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  options        PositionCustomFieldOption[]
  values         PositionCustomFieldValue[]
  employeeValues EmployeeCustomFieldValue[]

  @@unique([companyId, appliesTo, key], map: "pcf_defs_company_applies_key_key")
  @@index([companyId])
  @@index([companyId, appliesTo, active, sortOrder], map: "pcf_defs_company_applies_active_sort_idx")
  @@map("position_custom_field_definitions")
}

model PositionCustomFieldOption {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  definitionId String   @db.Uuid
  label        String
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  definition     PositionCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  values         PositionCustomFieldValue[]
  employeeValues EmployeeCustomFieldValue[]

  @@index([companyId])
  @@index([definitionId, sortOrder])
  @@map("position_custom_field_options")
}

/// Typed values per Position + definition. Avoids Position.metadata blobs.
model PositionCustomFieldValue {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  positionId   String    @db.Uuid
  definitionId String    @db.Uuid
  optionId     String?   @db.Uuid
  textValue    String?
  numberValue  Decimal?  @db.Decimal(18, 4)
  booleanValue Boolean?
  dateValue    DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  position   Position                      @relation(fields: [positionId], references: [id], onDelete: Restrict)
  definition PositionCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  option     PositionCustomFieldOption?    @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([positionId, definitionId])
  @@index([companyId])
  @@index([definitionId])
  @@index([optionId])
  @@map("position_custom_field_values")
}

/// Typed values per Employee + definition. Avoids Employee.metadata blobs.
model EmployeeCustomFieldValue {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  employeeId   String    @db.Uuid
  definitionId String    @db.Uuid
  optionId     String?   @db.Uuid
  textValue    String?
  numberValue  Decimal?  @db.Decimal(18, 4)
  booleanValue Boolean?
  dateValue    DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  definition PositionCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  option     PositionCustomFieldOption?    @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([employeeId, definitionId])
  @@index([companyId])
  @@index([definitionId])
  @@index([optionId])
  @@map("employee_custom_field_values")
}

model Employee {
  id                    String         @id @default(uuid()) @db.Uuid
  companyId             String         @db.Uuid
  userId                String?        @db.Uuid
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  documentType          String?
  documentNumber        String?
  birthDate             DateTime?      @db.Date
  country               String?
  state                 String?
  city                  String?
  maritalStatus         String?
  childrenCount         Int?
  housingType           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  businessUnitId        String?        @db.Uuid
  areaId                String         @db.Uuid
  positionId            String         @db.Uuid
  status                EmployeeStatus @default(ACTIVE)
  hireDate              DateTime?      @db.Date
  terminationDate       DateTime?      @db.Date
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user              User?                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessUnit      BusinessUnit?              @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  area              Area                       @relation(fields: [areaId], references: [id], onDelete: Restrict)
  position          Position                   @relation(fields: [positionId], references: [id], onDelete: Restrict)
  customFieldValues EmployeeCustomFieldValue[]

  reportingTo                       EmployeeReportingLine[]                @relation("EmployeeReports")
  managedReports                    EmployeeReportingLine[]                @relation("ManagerReports")
  vacancyRequestsRequested          VacancyRequest[]                       @relation("VacancyRequestedBy")
  vacancyApprovals                  VacancyApproval[]                      @relation("VacancyApprover")
  vacancyApprovalWorkflowSteps      VacancyApprovalWorkflowStep[]          @relation("WorkflowStepApprover")
  vacancyEvaluatorDefaults          VacancyEvaluatorDefault[]              @relation("EvaluatorDefaultEmployee")
  vacancyRequestEvaluators          VacancyRequestEvaluator[]              @relation("RequestEvaluatorEmployee")
  vacancyRequestApprovalPlanSteps   VacancyRequestApprovalPlanStep[]       @relation("PlanStepApprover")
  interviewAssignments              InterviewInterviewer[]
  hiring                            Hiring?
  performanceParticipations         PerformanceCycleParticipant[]
  performanceEvaluationsAsSubject   PerformanceEvaluation[]                @relation("EvaluationSubject")
  performanceEvaluationsAsEvaluator PerformanceEvaluation[]                @relation("EvaluationEvaluator")
  performanceResults                PerformanceResult[]
  performanceGoalDefinitions        PerformanceGoalDefinition[]
  goalDefinitionsReviewed           PerformanceGoalDefinition[]            @relation("GoalDefinitionReviewer")
  individualDevelopmentPlans        PerformanceIndividualDevelopmentPlan[]
  goalModificationRequests          PerformanceGoalModificationRequest[]
  goalModificationsReviewed         PerformanceGoalModificationRequest[]   @relation("GoalModificationReviewer")
  performanceNotifications          PerformanceNotification[]
  closingSessions                   PerformanceClosingSession[]
  calibrationPlacements             CalibrationPlacement[]
  goalAssignments                   GoalAssignment[]
  goalCheckIns                      GoalCheckIn[]
  goalCompletionRequests            GoalCompletionRequest[]
  goalResultApplicableEmployees     GoalResultApplicableEmployee[]
  assignedVacancies                 Vacancy[]                              @relation("VacancyAssignedRecruiter")
  calibrationSessionInvitees        CalibrationSessionInvitee[]
  calibrationSessionLeaders         CalibrationSessionLeader[]

  @@unique([companyId, email])
  @@unique([companyId, userId])
  @@index([companyId])
  @@index([areaId])
  @@index([positionId])
  @@index([businessUnitId])
  @@index([userId])
  @@index([status])
  @@map("employees")
}

model EmployeeReportingLine {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @db.Uuid
  employeeId        String            @db.Uuid
  managerEmployeeId String            @db.Uuid
  type              ReportingLineType
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation("EmployeeReports", fields: [employeeId], references: [id], onDelete: Restrict)
  manager  Employee @relation("ManagerReports", fields: [managerEmployeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, managerEmployeeId, type])
  @@index([companyId])
  @@index([employeeId])
  @@index([managerEmployeeId])
  @@map("employee_reporting_lines")
}

// ---------------------------------------------------------------------------
// ATS — Vacancy requests & vacancies
// ---------------------------------------------------------------------------

enum VacancyRequestType {
  EXISTING_POSITION
  NEW_POSITION
}

enum VacancyRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum VacancyApprovalPlanOrigin {
  DEFAULT
  CUSTOM
}

enum VacancyApprovalStep {
  DIRECT_MANAGER
  HR
  GENERAL_MANAGER
  ROLE
  SPECIFIC_EMPLOYEE
  POSITION
}

enum VacancyApproverType {
  MANAGER_OF_REQUESTER
  SPECIFIC_EMPLOYEE
  ROLE
  POSITION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum VacancyStatus {
  OPEN
  PAUSED
  CLOSED
  CANCELLED
}

model VacancyRequest {
  id                             String               @id @default(uuid()) @db.Uuid
  companyId                      String               @db.Uuid
  requestedByEmployeeId          String               @db.Uuid
  type                           VacancyRequestType
  existingPositionId             String?              @db.Uuid
  requestedPositionName          String?
  requestedAreaId                String?              @db.Uuid
  requestedJobLevelId            String?              @db.Uuid
  requestedHeadcount             Int
  justification                  String
  generalManagerApprovalRequired Boolean              @default(false)
  status                         VacancyRequestStatus @default(DRAFT)
  submittedAt                    DateTime?
  approvedAt                     DateTime?
  rejectedAt                     DateTime?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  deletedAt                      DateTime?

  company             Company                          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestedByEmployee Employee                         @relation("VacancyRequestedBy", fields: [requestedByEmployeeId], references: [id], onDelete: Restrict)
  existingPosition    Position?                        @relation(fields: [existingPositionId], references: [id], onDelete: Restrict)
  requestedArea       Area?                            @relation(fields: [requestedAreaId], references: [id], onDelete: Restrict)
  requestedJobLevel   JobLevel?                        @relation(fields: [requestedJobLevelId], references: [id], onDelete: Restrict)
  approvals           VacancyApproval[]
  evaluators          VacancyRequestEvaluator[]
  approvalPlanSteps   VacancyRequestApprovalPlanStep[]
  vacancy             Vacancy?

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@index([requestedByEmployeeId])
  @@index([existingPositionId])
  @@map("vacancy_requests")
}

model VacancyApproval {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  vacancyRequestId   String              @db.Uuid
  step               VacancyApprovalStep
  sequence           Int
  label              String?
  positionId         String?             @db.Uuid
  approverEmployeeId String?             @db.Uuid
  requiredRoleCode   String?
  status             ApprovalStatus      @default(PENDING)
  decidedByUserId    String?             @db.Uuid
  decidedAt          DateTime?
  comment            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vacancyRequest   VacancyRequest @relation(fields: [vacancyRequestId], references: [id], onDelete: Restrict)
  position         Position?      @relation(fields: [positionId], references: [id], onDelete: Restrict)
  approverEmployee Employee?      @relation("VacancyApprover", fields: [approverEmployeeId], references: [id], onDelete: Restrict)
  decidedByUser    User?          @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([vacancyRequestId, sequence])
  @@index([companyId])
  @@index([vacancyRequestId])
  @@index([status])
  @@index([positionId])
  @@index([approverEmployeeId])
  @@map("vacancy_approvals")
}

/// Per-company configuration for vacancy-request approval steps.
/// `enabled = false` (or missing row) keeps the legacy hardcoded flow.
model VacancyApprovalWorkflow {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @unique @db.Uuid
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  steps   VacancyApprovalWorkflowStep[]

  @@map("vacancy_approval_workflows")
}

model VacancyApprovalWorkflowStep {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  workflowId         String              @db.Uuid
  sequence           Int
  approverType       VacancyApproverType
  label              String?
  positionId         String?             @db.Uuid
  specificEmployeeId String?             @db.Uuid
  requiredRoleCode   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workflow         VacancyApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position         Position?               @relation(fields: [positionId], references: [id], onDelete: Restrict)
  specificEmployee Employee?               @relation("WorkflowStepApprover", fields: [specificEmployeeId], references: [id], onDelete: Restrict)

  @@unique([workflowId, sequence])
  @@index([companyId])
  @@index([positionId])
  @@index([specificEmployeeId])
  @@map("vacancy_approval_workflow_steps")
}

/// Per-request approval plan: frozen global defaults plus extra levels added on the form.
model VacancyRequestApprovalPlanStep {
  id                 String                    @id @default(uuid()) @db.Uuid
  companyId          String                    @db.Uuid
  vacancyRequestId   String                    @db.Uuid
  sequence           Int
  origin             VacancyApprovalPlanOrigin
  approverType       VacancyApproverType
  label              String?
  positionId         String?                   @db.Uuid
  specificEmployeeId String?                   @db.Uuid
  requiredRoleCode   String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vacancyRequest   VacancyRequest @relation(fields: [vacancyRequestId], references: [id], onDelete: Restrict)
  position         Position?      @relation(fields: [positionId], references: [id], onDelete: Restrict)
  specificEmployee Employee?      @relation("PlanStepApprover", fields: [specificEmployeeId], references: [id], onDelete: Restrict)

  @@unique([vacancyRequestId, sequence], map: "vacancy_request_approval_plan_steps_vacancyRequestId_sequence_k")
  @@index([companyId])
  @@index([vacancyRequestId])
  @@index([positionId])
  @@index([specificEmployeeId])
  @@map("vacancy_request_approval_plan_steps")
}

/// Company-level default interview/process evaluators (cargo + optional occupant).
model VacancyEvaluatorDefault {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  sequence   Int
  positionId String   @db.Uuid
  employeeId String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  position Position  @relation(fields: [positionId], references: [id], onDelete: Restrict)
  employee Employee? @relation("EvaluatorDefaultEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([companyId, sequence])
  @@index([companyId])
  @@index([positionId])
  @@index([employeeId])
  @@map("vacancy_evaluator_defaults")
}

/// Snapshot of evaluators for a submitted selection process.
model VacancyRequestEvaluator {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  vacancyRequestId String   @db.Uuid
  sequence         Int
  positionId       String   @db.Uuid
  employeeId       String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vacancyRequest VacancyRequest @relation(fields: [vacancyRequestId], references: [id], onDelete: Restrict)
  position       Position       @relation(fields: [positionId], references: [id], onDelete: Restrict)
  employee       Employee       @relation("RequestEvaluatorEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([vacancyRequestId, sequence])
  @@index([companyId])
  @@index([vacancyRequestId])
  @@index([positionId])
  @@index([employeeId])
  @@map("vacancy_request_evaluators")
}

model Vacancy {
  id                          String        @id @default(uuid()) @db.Uuid
  companyId                   String        @db.Uuid
  vacancyRequestId            String        @unique @db.Uuid
  positionId                  String        @db.Uuid
  areaId                      String        @db.Uuid
  assignedRecruiterEmployeeId String?       @db.Uuid
  interviewFormTemplateId     String?       @db.Uuid
  title                       String
  description                 String?
  salaryAmount                Decimal?      @db.Decimal(14, 2)
  salaryCurrency              String        @default("COP") @db.VarChar(3)
  showSalaryPublic            Boolean       @default(false)
  headcount                   Int
  filledCount                 Int           @default(0)
  status                      VacancyStatus @default(OPEN)
  publicId                    String?       @unique
  publishedAt                 DateTime?
  openedAt                    DateTime      @default(now())
  closedAt                    DateTime?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  deletedAt                   DateTime?

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vacancyRequest        VacancyRequest         @relation(fields: [vacancyRequestId], references: [id], onDelete: Restrict)
  position              Position               @relation(fields: [positionId], references: [id], onDelete: Restrict)
  area                  Area                   @relation(fields: [areaId], references: [id], onDelete: Restrict)
  assignedRecruiter     Employee?              @relation("VacancyAssignedRecruiter", fields: [assignedRecruiterEmployeeId], references: [id], onDelete: Restrict)
  interviewFormTemplate InterviewFormTemplate? @relation(fields: [interviewFormTemplateId], references: [id], onDelete: SetNull)
  applications          Application[]
  hirings               Hiring[]

  @@index([companyId])
  @@index([positionId])
  @@index([areaId])
  @@index([status])
  @@index([assignedRecruiterEmployeeId])
  @@index([interviewFormTemplateId])
  @@map("vacancies")
}

// ---------------------------------------------------------------------------
// ATS — Candidates & applications pipeline
// ---------------------------------------------------------------------------

enum CandidateStatus {
  ACTIVE
  INACTIVE
  HIRED
}

enum ApplicationStage {
  PENDING_REVIEW
  CONTACTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ApplicationStatus {
  ACTIVE
  CLOSED
}

model Candidate {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  firstName      String
  lastName       String
  email          String
  phone          String?
  documentType   String?
  documentNumber String?
  country        String?
  state          String?
  city           String?
  source         String?
  status         CandidateStatus @default(ACTIVE)
  cvFileName     String?
  cvOriginalName String?
  cvMimeType     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  applications Application[]
  hirings      Hiring[]

  @@unique([companyId, email])
  @@unique([companyId, documentNumber])
  @@index([companyId])
  @@index([status])
  @@map("candidates")
}

model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @db.Uuid
  candidateId        String            @db.Uuid
  vacancyId          String            @db.Uuid
  stage              ApplicationStage  @default(PENDING_REVIEW)
  status             ApplicationStatus @default(ACTIVE)
  appliedAt          DateTime          @default(now())
  lastStageChangedAt DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  candidate  Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  vacancy    Vacancy                   @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  history    ApplicationStageHistory[]
  interviews Interview[]
  jobOffer   JobOffer?
  hiring     Hiring?

  @@unique([candidateId, vacancyId])
  @@index([companyId])
  @@index([vacancyId])
  @@index([candidateId])
  @@index([stage])
  @@index([status])
  @@map("applications")
}

model ApplicationStageHistory {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  applicationId   String            @db.Uuid
  fromStage       ApplicationStage?
  toStage         ApplicationStage
  changedByUserId String?           @db.Uuid
  comment         String?
  createdAt       DateTime          @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  changedBy   User?       @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([applicationId])
  @@index([createdAt])
  @@map("application_stage_histories")
}

// ---------------------------------------------------------------------------
// ATS — Interviews, forms & textual transcripts
// ---------------------------------------------------------------------------

enum InterviewType {
  HR
  TECHNICAL
  MANAGER
  GENERAL
  OTHER
}

enum InterviewStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InterviewFormStatus {
  ACTIVE
  INACTIVE
}

enum InterviewQuestionType {
  TEXT
  TEXTAREA
  RATING
  YES_NO
}

enum TranscriptSegmentKind {
  QUESTION
  ANSWER
  NOTE
  UNCLASSIFIED
}

model Interview {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @db.Uuid
  applicationId      String          @db.Uuid
  type               InterviewType
  status             InterviewStatus @default(DRAFT)
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  location           String?
  meetingUrl         String?
  notes              String?
  /// Client-side display name only. Never a server-accessible file path.
  localRecordingName String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  company      Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application  Application                  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  interviewers InterviewInterviewer[]
  questions    InterviewQuestion[]
  transcripts  InterviewTranscriptSegment[]

  @@index([companyId])
  @@index([applicationId])
  @@index([status])
  @@index([type])
  @@map("interviews")
}

model InterviewInterviewer {
  interviewId String   @db.Uuid
  employeeId  String   @db.Uuid
  createdAt   DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([interviewId, employeeId])
  @@index([employeeId])
  @@map("interview_interviewers")
}

model InterviewFormTemplate {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @db.Uuid
  name        String
  description String?
  type        InterviewType
  status      InterviewFormStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  questions InterviewFormQuestion[]
  vacancies Vacancy[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@map("interview_form_templates")
}

model InterviewFormQuestion {
  id         String                @id @default(uuid()) @db.Uuid
  companyId  String                @db.Uuid
  templateId String                @db.Uuid
  text       String
  type       InterviewQuestionType
  required   Boolean               @default(true)
  weight     Int?
  order      Int
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  template InterviewFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, order])
  @@index([companyId])
  @@index([templateId])
  @@map("interview_form_questions")
}

/// Snapshot of a template question bound to a specific interview.
model InterviewQuestion {
  id                       String                @id @default(uuid()) @db.Uuid
  companyId                String                @db.Uuid
  interviewId              String                @db.Uuid
  sourceTemplateQuestionId String?               @db.Uuid
  text                     String
  type                     InterviewQuestionType
  required                 Boolean               @default(true)
  weight                   Int?
  order                    Int
  createdAt                DateTime              @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interview Interview         @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  answers   InterviewAnswer[]

  @@unique([interviewId, order])
  @@index([companyId])
  @@index([interviewId])
  @@map("interview_questions")
}

model InterviewAnswer {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @db.Uuid
  interviewQuestionId String   @db.Uuid
  answerText          String?
  rating              Int?
  yesNo               Boolean?
  answeredByUserId    String   @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interviewQuestion InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Restrict)
  answeredBy        User              @relation(fields: [answeredByUserId], references: [id], onDelete: Restrict)

  @@unique([interviewQuestionId, answeredByUserId])
  @@index([companyId])
  @@index([interviewQuestionId])
  @@index([answeredByUserId])
  @@map("interview_answers")
}

model InterviewTranscriptSegment {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @db.Uuid
  interviewId     String                @db.Uuid
  sequence        Int
  speakerLabel    String?
  kind            TranscriptSegmentKind @default(UNCLASSIFIED)
  text            String
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([interviewId, sequence])
  @@index([companyId])
  @@index([interviewId])
  @@index([createdByUserId])
  @@map("interview_transcript_segments")
}

// ---------------------------------------------------------------------------
// ATS — Job offers (formal offer after interviews; Hiring is 06B)
// ---------------------------------------------------------------------------

enum JobOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum SalaryPeriod {
  MONTHLY
  ANNUAL
  HOURLY
}

/// Colombian-oriented employment modality for offers (v1).
enum OfferEmploymentType {
  FULL_TIME
  PART_TIME
  FIXED_TERM
  CONTRACTOR
}

model JobOffer {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  applicationId   String              @unique @db.Uuid
  status          JobOfferStatus      @default(DRAFT)
  positionTitle   String
  salaryAmount    Decimal             @db.Decimal(14, 2)
  salaryCurrency  String              @default("COP") @db.VarChar(3)
  salaryPeriod    SalaryPeriod        @default(MONTHLY)
  employmentType  OfferEmploymentType @default(FULL_TIME)
  startDate       DateTime?           @db.Date
  expiresAt       DateTime?
  notes           String?
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  withdrawnAt     DateTime?
  expiredAt       DateTime?
  createdByUserId String              @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdBy   User        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  hiring      Hiring?

  @@index([companyId])
  @@index([status])
  @@index([createdByUserId])
  @@map("job_offers")
}

// ---------------------------------------------------------------------------
// ATS — Hiring (transactional close of selection → Organization Employee)
// ---------------------------------------------------------------------------

model Hiring {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  applicationId String   @unique @db.Uuid
  jobOfferId    String   @unique @db.Uuid
  employeeId    String   @unique @db.Uuid
  candidateId   String   @db.Uuid
  vacancyId     String   @db.Uuid
  hiredByUserId String   @db.Uuid
  hireDate      DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  jobOffer    JobOffer    @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  vacancy     Vacancy     @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  hiredBy     User        @relation(fields: [hiredByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([candidateId])
  @@index([vacancyId])
  @@index([hiredByUserId])
  @@map("hirings")
}

// ---------------------------------------------------------------------------
// Performance — Cycles, competencies & scales (08A configuration core)
// Evaluations / assignments (08B): participants + SELF/MANAGER + snapshots
// ---------------------------------------------------------------------------

enum PerformanceCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum PerformanceParticipantStatus {
  ACTIVE
  COMPLETED
  EXCLUDED
}

enum PerformanceEvaluationModel {
  DEGREE_90
  DEGREE_180
  DEGREE_270
  DEGREE_360
}

enum PerformanceEvaluationType {
  SELF
  MANAGER
  PEER
  REPORT
  CLIENT
}

enum PerformanceEvaluationStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
}

enum PerformanceResultStatus {
  CALCULATED
  RELEASED
}

/// Distinguishes 08D competency-only results from 09D integrated Goals composition.
enum PerformanceResultComposition {
  COMPETENCY_ONLY
  COMPETENCY_AND_GOALS
}

/// Qualitative scales rate competencies (labels). Quantitative scales are numeric, not for competencies.
enum CompetencyScaleKind {
  QUALITATIVE
  QUANTITATIVE
}

/// Specific layout of a rating scale. Must match `CompetencyScale.kind`.
enum CompetencyScaleFormat {
  NUMERIC
  DESCRIPTIVE
  LIKERT
  PERCENTAGE
  CURRENCY
}

model PerformanceCycle {
  id                         String                     @id @default(uuid()) @db.Uuid
  companyId                  String                     @db.Uuid
  name                       String
  description                String?
  startDate                  DateTime                   @db.Date
  endDate                    DateTime                   @db.Date
  /// Self-evaluation window (UI: Fecha Autoevaluación).
  evaluationStartDate        DateTime?                  @db.Date
  evaluationEndDate          DateTime?                  @db.Date
  goalDefinitionStartDate    DateTime?                  @db.Date
  goalDefinitionEndDate      DateTime?                  @db.Date
  /// Leader / peer / report / client evaluation window (UI: Fecha Evaluación).
  managerEvaluationStartDate DateTime?                  @db.Date
  managerEvaluationEndDate   DateTime?                  @db.Date
  calibrationStartDate       DateTime?                  @db.Date
  calibrationEndDate         DateTime?                  @db.Date
  closingStartDate           DateTime?                  @db.Date
  closingEndDate             DateTime?                  @db.Date
  status                     PerformanceCycleStatus     @default(DRAFT)
  evaluationModel            PerformanceEvaluationModel @default(DEGREE_90)
  /// Configured evaluator weights (DRAFT-editable). Enabled groups must sum to 100.
  selfEvaluationWeight       Decimal                    @default(30.00) @db.Decimal(5, 2)
  managerEvaluationWeight    Decimal                    @default(70.00) @db.Decimal(5, 2)
  peerEvaluationWeight       Decimal?                   @db.Decimal(5, 2)
  reportEvaluationWeight     Decimal?                   @db.Decimal(5, 2)
  clientEvaluationWeight     Decimal?                   @db.Decimal(5, 2)
  /// Optional GoalCycle link (09D). Null = competency-only (08D behavior).
  goalCycleId                String?                    @db.Uuid
  includeCompetencies        Boolean                    @default(true)
  /// Weight of competencyScore in overall (when goals are included).
  competencyResultWeight     Decimal?                   @db.Decimal(5, 2)
  /// Weight of goalsAchievement in overall (org + individual; legacy scoring).
  goalsResultWeight          Decimal?                   @db.Decimal(5, 2)
  organizationalGoalsWeight  Decimal?                   @db.Decimal(5, 2)
  individualGoalsWeight      Decimal?                   @db.Decimal(5, 2)
  maxObjectives              Int?
  /// Total evaluation range (100 or 120). Composition weights must not exceed it.
  evaluationRange            Int                        @default(100)
  createdByUserId            String                     @db.Uuid
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  company                    Company                                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy                  User                                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  goalCycle                  GoalCycle?                             @relation(fields: [goalCycleId], references: [id], onDelete: Restrict)
  competencies               PerformanceCycleCompetency[]
  participants               PerformanceCycleParticipant[]
  evaluations                PerformanceEvaluation[]
  results                    PerformanceResult[]
  followUps                  PerformanceCycleFollowUp[]
  goalDefinitions            PerformanceGoalDefinition[]
  individualDevelopmentPlans PerformanceIndividualDevelopmentPlan[]
  goalModificationRequests   PerformanceGoalModificationRequest[]
  closingSessions            PerformanceClosingSession[]
  notifications              PerformanceNotification[]

  @@index([companyId])
  @@index([status])
  @@index([createdByUserId])
  @@index([goalCycleId])
  @@map("performance_cycles")
}

model PerformanceCycleFollowUp {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  cycleId   String   @db.Uuid
  order     Int      @default(0)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

