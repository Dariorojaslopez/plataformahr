generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  BLOCKED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Language {
  ES
  EN
  PT
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum RoleScope {
  PLATFORM
  COMPANY
}

enum PlatformModule {
  ATS
  PERFORMANCE
  DEVELOPMENT
  TRAINING
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

/// Global identity. Platform owners do not require a company membership.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?
  firstName       String
  lastName        String
  status          UserStatus @default(INVITED)
  isPlatformOwner Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  memberships                     CompanyMembership[]
  sessions                        UserSession[]
  auditLogs                       AuditLog[]
  employees                       Employee[]
  vacancyApprovalsDecided         VacancyApproval[]
  applicationStageHistories       ApplicationStageHistory[]
  interviewAnswers                InterviewAnswer[]
  interviewTranscriptSegments     InterviewTranscriptSegment[]
  jobOffersCreated                JobOffer[]
  hiringsCompleted                Hiring[]
  performanceCyclesCreated        PerformanceCycle[]
  performanceResultsReleased      PerformanceResult[]          @relation("PerformanceResultReleasedBy")
  goalCyclesCreated               GoalCycle[]
  goalsCreated                    Goal[]
  goalCheckInsCreated             GoalCheckIn[]
  goalCompletionRequestsRequested GoalCompletionRequest[]      @relation("GoalCompletionRequestedBy")
  goalCompletionRequestsReviewed  GoalCompletionRequest[]      @relation("GoalCompletionReviewedBy")
  goalResultsRequested            GoalResult[]                 @relation("GoalResultRequestedBy")
  goalResultsApproved             GoalResult[]                 @relation("GoalResultApprovedBy")

  @@map("users")
}

/// Persistent auth session. Only the refresh token hash is stored.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?
  ipAddress        String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

/// Tenant root. Business entities must scope by companyId.
model Company {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  legalName       String?
  slug            String        @unique
  status          CompanyStatus @default(ACTIVE)
  defaultLanguage Language      @default(ES)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  memberships                       CompanyMembership[]
  modules                           CompanyModule[]
  auditLogs                         AuditLog[]
  businessUnits                     BusinessUnit[]
  areas                             Area[]
  jobLevels                         JobLevel[]
  jobLevelCompetencies              JobLevelCompetency[]
  positions                         Position[]
  employees                         Employee[]
  reportingLines                    EmployeeReportingLine[]
  vacancyRequests                   VacancyRequest[]
  vacancyApprovals                  VacancyApproval[]
  vacancies                         Vacancy[]
  candidates                        Candidate[]
  applications                      Application[]
  applicationStageHistories         ApplicationStageHistory[]
  interviews                        Interview[]
  interviewFormTemplates            InterviewFormTemplate[]
  interviewFormQuestions            InterviewFormQuestion[]
  interviewQuestions                InterviewQuestion[]
  interviewAnswers                  InterviewAnswer[]
  interviewTranscriptSegments       InterviewTranscriptSegment[]
  jobOffers                         JobOffer[]
  hirings                           Hiring[]
  performanceCycles                 PerformanceCycle[]
  competencies                      Competency[]
  competencyScales                  CompetencyScale[]
  competencyScaleLevels             CompetencyScaleLevel[]
  performanceCycleCompetencies      PerformanceCycleCompetency[]
  performanceCycleParticipants      PerformanceCycleParticipant[]
  performanceEvaluations            PerformanceEvaluation[]
  performanceEvaluationCompetencies PerformanceEvaluationCompetency[]
  performanceEvaluationScaleLevels  PerformanceEvaluationScaleLevel[]
  performanceEvaluationResponses    PerformanceEvaluationResponse[]
  performanceResults                PerformanceResult[]
  performanceResultGoals            PerformanceResultGoal[]
  goalCycles                        GoalCycle[]
  goals                             Goal[]
  goalAssignments                   GoalAssignment[]
  goalKeyResults                    GoalKeyResult[]
  goalCheckIns                      GoalCheckIn[]
  goalCompletionRequests            GoalCompletionRequest[]
  goalResults                       GoalResult[]
  goalResultKeyResults              GoalResultKeyResult[]
  goalResultApplicableEmployees     GoalResultApplicableEmployee[]

  @@map("companies")
}

/// User <-> Company membership. Users never store companyId directly.
model CompanyMembership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  companyId String           @db.Uuid
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  roles   MembershipRole[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String
  name        String
  description String?
  scope       RoleScope
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  membershipRoles MembershipRole[]
  permissions     RolePermission[]

  @@unique([scope, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model MembershipRole {
  membershipId String   @db.Uuid
  roleId       String   @db.Uuid
  createdAt    DateTime @default(now())

  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Tenant modules
// ---------------------------------------------------------------------------

model CompanyModule {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  module    PlatformModule
  enabled   Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, module])
  @@map("company_modules")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-oriented audit trail. companyId is nullable for platform-level actions.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Organization
// ---------------------------------------------------------------------------

enum OrganizationEntityStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ReportingLineType {
  DIRECT
  INDIRECT
}

model BusinessUnit {
  id          String                   @id @default(uuid()) @db.Uuid
  companyId   String                   @db.Uuid
  name        String
  code        String?
  description String?
  status      OrganizationEntityStatus @default(ACTIVE)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  areas     Area[]
  employees Employee[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@map("business_units")
}

model Area {
  id             String                   @id @default(uuid()) @db.Uuid
  companyId      String                   @db.Uuid
  businessUnitId String?                  @db.Uuid
  parentAreaId   String?                  @db.Uuid
  name           String
  code           String?
  description    String?
  status         OrganizationEntityStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  businessUnit    BusinessUnit?    @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  parentArea      Area?            @relation("AreaHierarchy", fields: [parentAreaId], references: [id], onDelete: Restrict)
  childAreas      Area[]           @relation("AreaHierarchy")
  positions       Position[]
  employees       Employee[]
  vacancyRequests VacancyRequest[]
  vacancies       Vacancy[]
  goals           Goal[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([businessUnitId])
  @@index([parentAreaId])
  @@map("areas")
}

model JobLevel {
  id        String                   @id @default(uuid()) @db.Uuid
  companyId String                   @db.Uuid
  name      String
  code      String?
  rank      Int
  status    OrganizationEntityStatus @default(ACTIVE)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  deletedAt DateTime?

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  positions       Position[]
  vacancyRequests VacancyRequest[]
  competencies    JobLevelCompetency[]

  @@unique([companyId, name])
  @@unique([companyId, rank])
  @@unique([companyId, code])
  @@index([companyId])
  @@map("job_levels")
}

/// Tenant-scoped assignment of catalog competencies to a job level.
/// Live configuration only — Performance evaluations snapshot cycle competencies separately.
model JobLevelCompetency {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  jobLevelId    String   @db.Uuid
  competencyId  String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  jobLevel   JobLevel   @relation(fields: [jobLevelId], references: [id], onDelete: Restrict)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@unique([jobLevelId, competencyId])
  @@index([companyId])
  @@index([jobLevelId])
  @@index([competencyId])
  @@map("job_level_competencies")
}

model Position {
  id                 String                   @id @default(uuid()) @db.Uuid
  companyId          String                   @db.Uuid
  areaId             String                   @db.Uuid
  jobLevelId         String?                  @db.Uuid
  name               String
  code               String?
  mission            String?
  responsibilities   String?
  requiredExperience String?
  requiredEducation  String?
  headcount          Int                      @default(1)
  status             OrganizationEntityStatus @default(ACTIVE)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  area            Area             @relation(fields: [areaId], references: [id], onDelete: Restrict)
  jobLevel        JobLevel?        @relation(fields: [jobLevelId], references: [id], onDelete: Restrict)
  employees       Employee[]
  vacancyRequests VacancyRequest[]
  vacancies       Vacancy[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([areaId])
  @@index([jobLevelId])
  @@map("positions")
}

model Employee {
  id                    String         @id @default(uuid()) @db.Uuid
  companyId             String         @db.Uuid
  userId                String?        @db.Uuid
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  birthDate             DateTime?      @db.Date
  country               String?
  state                 String?
  city                  String?
  maritalStatus         String?
  childrenCount         Int?
  housingType           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  businessUnitId        String?        @db.Uuid
  areaId                String         @db.Uuid
  positionId            String         @db.Uuid
  status                EmployeeStatus @default(ACTIVE)
  hireDate              DateTime?      @db.Date
  terminationDate       DateTime?      @db.Date
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  area         Area          @relation(fields: [areaId], references: [id], onDelete: Restrict)
  position     Position      @relation(fields: [positionId], references: [id], onDelete: Restrict)

  reportingTo                       EmployeeReportingLine[]        @relation("EmployeeReports")
  managedReports                    EmployeeReportingLine[]        @relation("ManagerReports")
  vacancyRequestsRequested          VacancyRequest[]               @relation("VacancyRequestedBy")
  vacancyApprovals                  VacancyApproval[]              @relation("VacancyApprover")
  interviewAssignments              InterviewInterviewer[]
  hiring                            Hiring?
  performanceParticipations         PerformanceCycleParticipant[]
  performanceEvaluationsAsSubject   PerformanceEvaluation[]        @relation("EvaluationSubject")
  performanceEvaluationsAsEvaluator PerformanceEvaluation[]        @relation("EvaluationEvaluator")
  performanceResults                PerformanceResult[]
  goalAssignments                   GoalAssignment[]
  goalCheckIns                      GoalCheckIn[]
  goalCompletionRequests            GoalCompletionRequest[]
  goalResultApplicableEmployees     GoalResultApplicableEmployee[]

  @@unique([companyId, email])
  @@unique([companyId, userId])
  @@index([companyId])
  @@index([areaId])
  @@index([positionId])
  @@index([businessUnitId])
  @@index([userId])
  @@index([status])
  @@map("employees")
}

model EmployeeReportingLine {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @db.Uuid
  employeeId        String            @db.Uuid
  managerEmployeeId String            @db.Uuid
  type              ReportingLineType
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation("EmployeeReports", fields: [employeeId], references: [id], onDelete: Restrict)
  manager  Employee @relation("ManagerReports", fields: [managerEmployeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, managerEmployeeId, type])
  @@index([companyId])
  @@index([employeeId])
  @@index([managerEmployeeId])
  @@map("employee_reporting_lines")
}

// ---------------------------------------------------------------------------
// ATS — Vacancy requests & vacancies
// ---------------------------------------------------------------------------

enum VacancyRequestType {
  EXISTING_POSITION
  NEW_POSITION
}

enum VacancyRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum VacancyApprovalStep {
  DIRECT_MANAGER
  HR
  GENERAL_MANAGER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum VacancyStatus {
  OPEN
  PAUSED
  CLOSED
  CANCELLED
}

model VacancyRequest {
  id                             String               @id @default(uuid()) @db.Uuid
  companyId                      String               @db.Uuid
  requestedByEmployeeId          String               @db.Uuid
  type                           VacancyRequestType
  existingPositionId             String?              @db.Uuid
  requestedPositionName          String?
  requestedAreaId                String?              @db.Uuid
  requestedJobLevelId            String?              @db.Uuid
  requestedHeadcount             Int
  justification                  String
  generalManagerApprovalRequired Boolean              @default(false)
  status                         VacancyRequestStatus @default(DRAFT)
  submittedAt                    DateTime?
  approvedAt                     DateTime?
  rejectedAt                     DateTime?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  deletedAt                      DateTime?

  company             Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestedByEmployee Employee          @relation("VacancyRequestedBy", fields: [requestedByEmployeeId], references: [id], onDelete: Restrict)
  existingPosition    Position?         @relation(fields: [existingPositionId], references: [id], onDelete: Restrict)
  requestedArea       Area?             @relation(fields: [requestedAreaId], references: [id], onDelete: Restrict)
  requestedJobLevel   JobLevel?         @relation(fields: [requestedJobLevelId], references: [id], onDelete: Restrict)
  approvals           VacancyApproval[]
  vacancy             Vacancy?

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@index([requestedByEmployeeId])
  @@index([existingPositionId])
  @@map("vacancy_requests")
}

model VacancyApproval {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  vacancyRequestId   String              @db.Uuid
  step               VacancyApprovalStep
  sequence           Int
  approverEmployeeId String?             @db.Uuid
  requiredRoleCode   String?
  status             ApprovalStatus      @default(PENDING)
  decidedByUserId    String?             @db.Uuid
  decidedAt          DateTime?
  comment            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vacancyRequest   VacancyRequest @relation(fields: [vacancyRequestId], references: [id], onDelete: Restrict)
  approverEmployee Employee?      @relation("VacancyApprover", fields: [approverEmployeeId], references: [id], onDelete: Restrict)
  decidedByUser    User?          @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([vacancyRequestId, step])
  @@index([companyId])
  @@index([vacancyRequestId])
  @@index([status])
  @@index([approverEmployeeId])
  @@map("vacancy_approvals")
}

model Vacancy {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @db.Uuid
  vacancyRequestId String        @unique @db.Uuid
  positionId       String        @db.Uuid
  areaId           String        @db.Uuid
  title            String
  description      String?
  headcount        Int
  filledCount      Int           @default(0)
  status           VacancyStatus @default(OPEN)
  openedAt         DateTime      @default(now())
  closedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vacancyRequest VacancyRequest @relation(fields: [vacancyRequestId], references: [id], onDelete: Restrict)
  position       Position       @relation(fields: [positionId], references: [id], onDelete: Restrict)
  area           Area           @relation(fields: [areaId], references: [id], onDelete: Restrict)
  applications   Application[]
  hirings        Hiring[]

  @@index([companyId])
  @@index([positionId])
  @@index([areaId])
  @@index([status])
  @@map("vacancies")
}

// ---------------------------------------------------------------------------
// ATS — Candidates & applications pipeline
// ---------------------------------------------------------------------------

enum CandidateStatus {
  ACTIVE
  INACTIVE
  HIRED
}

enum ApplicationStage {
  PENDING_REVIEW
  CONTACTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ApplicationStatus {
  ACTIVE
  CLOSED
}

model Candidate {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  firstName      String
  lastName       String
  email          String
  phone          String?
  documentType   String?
  documentNumber String?
  country        String?
  state          String?
  city           String?
  source         String?
  status         CandidateStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  applications Application[]
  hirings      Hiring[]

  @@unique([companyId, email])
  @@unique([companyId, documentNumber])
  @@index([companyId])
  @@index([status])
  @@map("candidates")
}

model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @db.Uuid
  candidateId        String            @db.Uuid
  vacancyId          String            @db.Uuid
  stage              ApplicationStage  @default(PENDING_REVIEW)
  status             ApplicationStatus @default(ACTIVE)
  appliedAt          DateTime          @default(now())
  lastStageChangedAt DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  candidate  Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  vacancy    Vacancy                   @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  history    ApplicationStageHistory[]
  interviews Interview[]
  jobOffer   JobOffer?
  hiring     Hiring?

  @@unique([candidateId, vacancyId])
  @@index([companyId])
  @@index([vacancyId])
  @@index([candidateId])
  @@index([stage])
  @@index([status])
  @@map("applications")
}

model ApplicationStageHistory {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  applicationId   String            @db.Uuid
  fromStage       ApplicationStage?
  toStage         ApplicationStage
  changedByUserId String            @db.Uuid
  comment         String?
  createdAt       DateTime          @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  changedBy   User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([applicationId])
  @@index([createdAt])
  @@map("application_stage_histories")
}

// ---------------------------------------------------------------------------
// ATS — Interviews, forms & textual transcripts
// ---------------------------------------------------------------------------

enum InterviewType {
  HR
  TECHNICAL
  MANAGER
  GENERAL
  OTHER
}

enum InterviewStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InterviewFormStatus {
  ACTIVE
  INACTIVE
}

enum InterviewQuestionType {
  TEXT
  TEXTAREA
  RATING
  YES_NO
}

enum TranscriptSegmentKind {
  QUESTION
  ANSWER
  NOTE
  UNCLASSIFIED
}

model Interview {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @db.Uuid
  applicationId      String          @db.Uuid
  type               InterviewType
  status             InterviewStatus @default(DRAFT)
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  location           String?
  meetingUrl         String?
  notes              String?
  /// Client-side display name only. Never a server-accessible file path.
  localRecordingName String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  company      Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application  Application                  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  interviewers InterviewInterviewer[]
  questions    InterviewQuestion[]
  transcripts  InterviewTranscriptSegment[]

  @@index([companyId])
  @@index([applicationId])
  @@index([status])
  @@index([type])
  @@map("interviews")
}

model InterviewInterviewer {
  interviewId String   @db.Uuid
  employeeId  String   @db.Uuid
  createdAt   DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([interviewId, employeeId])
  @@index([employeeId])
  @@map("interview_interviewers")
}

model InterviewFormTemplate {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @db.Uuid
  name        String
  description String?
  type        InterviewType
  status      InterviewFormStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  questions InterviewFormQuestion[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@map("interview_form_templates")
}

model InterviewFormQuestion {
  id         String                @id @default(uuid()) @db.Uuid
  companyId  String                @db.Uuid
  templateId String                @db.Uuid
  text       String
  type       InterviewQuestionType
  required   Boolean               @default(true)
  weight     Int?
  order      Int
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  template InterviewFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, order])
  @@index([companyId])
  @@index([templateId])
  @@map("interview_form_questions")
}

/// Snapshot of a template question bound to a specific interview.
model InterviewQuestion {
  id                       String                @id @default(uuid()) @db.Uuid
  companyId                String                @db.Uuid
  interviewId              String                @db.Uuid
  sourceTemplateQuestionId String?               @db.Uuid
  text                     String
  type                     InterviewQuestionType
  required                 Boolean               @default(true)
  weight                   Int?
  order                    Int
  createdAt                DateTime              @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interview Interview         @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  answers   InterviewAnswer[]

  @@unique([interviewId, order])
  @@index([companyId])
  @@index([interviewId])
  @@map("interview_questions")
}

model InterviewAnswer {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @db.Uuid
  interviewQuestionId String   @db.Uuid
  answerText          String?
  rating              Int?
  yesNo               Boolean?
  answeredByUserId    String   @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interviewQuestion InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Restrict)
  answeredBy        User              @relation(fields: [answeredByUserId], references: [id], onDelete: Restrict)

  @@unique([interviewQuestionId, answeredByUserId])
  @@index([companyId])
  @@index([interviewQuestionId])
  @@index([answeredByUserId])
  @@map("interview_answers")
}

model InterviewTranscriptSegment {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @db.Uuid
  interviewId     String                @db.Uuid
  sequence        Int
  speakerLabel    String?
  kind            TranscriptSegmentKind @default(UNCLASSIFIED)
  text            String
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([interviewId, sequence])
  @@index([companyId])
  @@index([interviewId])
  @@index([createdByUserId])
  @@map("interview_transcript_segments")
}

// ---------------------------------------------------------------------------
// ATS — Job offers (formal offer after interviews; Hiring is 06B)
// ---------------------------------------------------------------------------

enum JobOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum SalaryPeriod {
  MONTHLY
  ANNUAL
  HOURLY
}

/// Colombian-oriented employment modality for offers (v1).
enum OfferEmploymentType {
  FULL_TIME
  PART_TIME
  FIXED_TERM
  CONTRACTOR
}

model JobOffer {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  applicationId   String              @unique @db.Uuid
  status          JobOfferStatus      @default(DRAFT)
  positionTitle   String
  salaryAmount    Decimal             @db.Decimal(14, 2)
  salaryCurrency  String              @default("COP") @db.VarChar(3)
  salaryPeriod    SalaryPeriod        @default(MONTHLY)
  employmentType  OfferEmploymentType @default(FULL_TIME)
  startDate       DateTime?           @db.Date
  expiresAt       DateTime?
  notes           String?
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  withdrawnAt     DateTime?
  expiredAt       DateTime?
  createdByUserId String              @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdBy   User        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  hiring      Hiring?

  @@index([companyId])
  @@index([status])
  @@index([createdByUserId])
  @@map("job_offers")
}

// ---------------------------------------------------------------------------
// ATS — Hiring (transactional close of selection → Organization Employee)
// ---------------------------------------------------------------------------

model Hiring {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  applicationId String   @unique @db.Uuid
  jobOfferId    String   @unique @db.Uuid
  employeeId    String   @unique @db.Uuid
  candidateId   String   @db.Uuid
  vacancyId     String   @db.Uuid
  hiredByUserId String   @db.Uuid
  hireDate      DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  jobOffer    JobOffer    @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  vacancy     Vacancy     @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  hiredBy     User        @relation(fields: [hiredByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([candidateId])
  @@index([vacancyId])
  @@index([hiredByUserId])
  @@map("hirings")
}

// ---------------------------------------------------------------------------
// Performance — Cycles, competencies & scales (08A configuration core)
// Evaluations / assignments (08B): participants + SELF/MANAGER + snapshots
// ---------------------------------------------------------------------------

enum PerformanceCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum PerformanceParticipantStatus {
  ACTIVE
  COMPLETED
  EXCLUDED
}

enum PerformanceEvaluationType {
  SELF
  MANAGER
}

enum PerformanceEvaluationStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
}

enum PerformanceResultStatus {
  CALCULATED
  RELEASED
}

/// Distinguishes 08D competency-only results from 09D integrated Goals composition.
enum PerformanceResultComposition {
  COMPETENCY_ONLY
  COMPETENCY_AND_GOALS
}

model PerformanceCycle {
  id                      String                 @id @default(uuid()) @db.Uuid
  companyId               String                 @db.Uuid
  name                    String
  description             String?
  startDate               DateTime               @db.Date
  endDate                 DateTime               @db.Date
  evaluationStartDate     DateTime?              @db.Date
  evaluationEndDate       DateTime?              @db.Date
  status                  PerformanceCycleStatus @default(DRAFT)
  /// Configured evaluator weights (DRAFT-editable). Must sum to 100 at activation.
  /// Defaults 30/70 for new cycles; not hardcoded in consolidation logic.
  selfEvaluationWeight    Decimal                @default(30.00) @db.Decimal(5, 2)
  managerEvaluationWeight Decimal                @default(70.00) @db.Decimal(5, 2)
  /// Optional GoalCycle link (09D). Null = competency-only (08D behavior).
  goalCycleId             String?                @db.Uuid
  /// Weight of competencyScore in overall (required when goalCycleId set; sum with goals = 100).
  competencyResultWeight  Decimal?               @db.Decimal(5, 2)
  /// Weight of goalsAchievement in overall (required when goalCycleId set).
  goalsResultWeight       Decimal?               @db.Decimal(5, 2)
  createdByUserId         String                 @db.Uuid
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  company      Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy    User                          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  goalCycle    GoalCycle?                    @relation(fields: [goalCycleId], references: [id], onDelete: Restrict)
  competencies PerformanceCycleCompetency[]
  participants PerformanceCycleParticipant[]
  evaluations  PerformanceEvaluation[]
  results      PerformanceResult[]

  @@index([companyId])
  @@index([status])
  @@index([createdByUserId])
  @@index([goalCycleId])
  @@map("performance_cycles")
}

model Competency {
  id             String                   @id @default(uuid()) @db.Uuid
  companyId      String                   @db.Uuid
  name           String
  code           String?
  description    String?
  status         OrganizationEntityStatus @default(ACTIVE)
  defaultScaleId String?                  @db.Uuid
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  company             Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultScale        CompetencyScale?             @relation("CompetencyDefaultScale", fields: [defaultScaleId], references: [id], onDelete: Restrict)
  cycleAssignments    PerformanceCycleCompetency[]
  jobLevelAssignments JobLevelCompetency[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@index([defaultScaleId])
  @@map("competencies")
}

model CompetencyScale {
  id          String                   @id @default(uuid()) @db.Uuid
  companyId   String                   @db.Uuid
  name        String
  description String?
  status      OrganizationEntityStatus @default(ACTIVE)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?

  company                Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  levels                 CompetencyScaleLevel[]
  defaultForCompetencies Competency[]                 @relation("CompetencyDefaultScale")
  cycleAssignments       PerformanceCycleCompetency[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
  @@map("competency_scales")
}

model CompetencyScaleLevel {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  scaleId     String   @db.Uuid
  value       Int
  label       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  scale   CompetencyScale @relation(fields: [scaleId], references: [id], onDelete: Restrict)

  @@unique([scaleId, value])
  @@unique([scaleId, order])
  @@index([companyId])
  @@index([scaleId])
  @@map("competency_scale_levels")
}

model PerformanceCycleCompetency {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  cycleId      String   @db.Uuid
  competencyId String   @db.Uuid
  scaleId      String   @db.Uuid
  weight       Decimal? @db.Decimal(5, 2)
  order        Int      @default(0)
  required     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cycle      PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  competency Competency       @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  scale      CompetencyScale  @relation(fields: [scaleId], references: [id], onDelete: Restrict)

  @@unique([cycleId, competencyId])
  @@index([companyId])
  @@index([cycleId])
  @@index([competencyId])
  @@index([scaleId])
  @@map("performance_cycle_competencies")
}

/// Employee participation in an ACTIVE performance cycle.
model PerformanceCycleParticipant {
  id         String                       @id @default(uuid()) @db.Uuid
  companyId  String                       @db.Uuid
  cycleId    String                       @db.Uuid
  employeeId String                       @db.Uuid
  status     PerformanceParticipantStatus @default(ACTIVE)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cycle       PerformanceCycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  employee    Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  evaluations PerformanceEvaluation[]
  result      PerformanceResult?

  @@unique([cycleId, employeeId])
  @@index([companyId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([status])
  @@map("performance_cycle_participants")
}

/// Materialized evaluation (SELF or MANAGER) with competency/scale snapshots.
model PerformanceEvaluation {
  id                  String                      @id @default(uuid()) @db.Uuid
  companyId           String                      @db.Uuid
  cycleId             String                      @db.Uuid
  participantId       String                      @db.Uuid
  employeeId          String                      @db.Uuid
  evaluatorEmployeeId String?                     @db.Uuid
  type                PerformanceEvaluationType
  status              PerformanceEvaluationStatus @default(PENDING)
  startedAt           DateTime?
  submittedAt         DateTime?
  /// Individual score for THIS evaluation only (0.00–100.00). Set on submit.
  /// SELF and MANAGER scores stay independent (no consolidation in 08C).
  scorePercentage     Decimal?                    @db.Decimal(5, 2)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  company           Company                           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cycle             PerformanceCycle                  @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  participant       PerformanceCycleParticipant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  employee          Employee                          @relation("EvaluationSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  evaluatorEmployee Employee?                         @relation("EvaluationEvaluator", fields: [evaluatorEmployeeId], references: [id], onDelete: Restrict)
  competencies      PerformanceEvaluationCompetency[]
  responses         PerformanceEvaluationResponse[]

  @@unique([participantId, type])
  @@index([companyId])
  @@index([cycleId])
  @@index([participantId])
  @@index([employeeId])
  @@index([evaluatorEmployeeId])
  @@index([type])
  @@index([status])
  @@map("performance_evaluations")
}

/// Historical snapshot of a cycle competency for one evaluation.
/// source* ids are traceability only (no FK) so catalog changes never break history.
model PerformanceEvaluationCompetency {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @db.Uuid
  evaluationId       String   @db.Uuid
  sourceCompetencyId String?  @db.Uuid
  sourceScaleId      String?  @db.Uuid
  name               String
  code               String?
  description        String?
  scaleName          String
  weight             Decimal? @db.Decimal(5, 2)
  required           Boolean  @default(true)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company    Company                           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  evaluation PerformanceEvaluation             @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  levels     PerformanceEvaluationScaleLevel[]
  response   PerformanceEvaluationResponse?

  @@index([companyId])
  @@index([evaluationId])
  @@index([sourceCompetencyId])
  @@map("performance_evaluation_competencies")
}

model PerformanceEvaluationScaleLevel {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @db.Uuid
  evaluationCompetencyId String   @db.Uuid
  sourceScaleLevelId     String?  @db.Uuid
  value                  Int
  label                  String
  description            String?
  order                  Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company              Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  evaluationCompetency PerformanceEvaluationCompetency @relation(fields: [evaluationCompetencyId], references: [id], onDelete: Restrict)
  selectedByResponses  PerformanceEvaluationResponse[]

  @@index([companyId])
  @@index([evaluationCompetencyId])
  @@map("performance_evaluation_scale_levels")
}

/// One rating (+ optional comment) per snapshot competency within an evaluation.
model PerformanceEvaluationResponse {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @db.Uuid
  evaluationId           String   @db.Uuid
  evaluationCompetencyId String   @db.Uuid
  selectedScaleLevelId   String   @db.Uuid
  /// Copied from snapshot level.value at save time (historical rating).
  ratingValue            Int
  comment                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company              Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  evaluation           PerformanceEvaluation           @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  evaluationCompetency PerformanceEvaluationCompetency @relation(fields: [evaluationCompetencyId], references: [id], onDelete: Restrict)
  selectedScaleLevel   PerformanceEvaluationScaleLevel @relation(fields: [selectedScaleLevelId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, evaluationCompetencyId])
  @@unique([evaluationCompetencyId])
  @@index([companyId])
  @@index([evaluationId])
  @@index([selectedScaleLevelId])
  @@map("performance_evaluation_responses")
}

/// Historical consolidated result for a participant. Immutable after calculate.
/// 08D: composition COMPETENCY_ONLY → overallScore is competency consolidation.
/// 09D: COMPETENCY_AND_GOALS → overallScore blends competencyScore + goalsAchievement.
model PerformanceResult {
  id                               String                       @id @default(uuid()) @db.Uuid
  companyId                        String                       @db.Uuid
  cycleId                          String                       @db.Uuid
  participantId                    String                       @db.Uuid
  employeeId                       String                       @db.Uuid
  selfScore                        Decimal?                     @db.Decimal(5, 2)
  managerScore                     Decimal?                     @db.Decimal(5, 2)
  /// For COMPETENCY_ONLY equals historical 08D overall. For integrated = competency component.
  competencyScore                  Decimal?                     @db.Decimal(5, 2)
  goalsAchievement                 Decimal?                     @db.Decimal(5, 2)
  /// Effective overall (analytics/CSV authority). Legacy rows: competency consolidation.
  overallScore                     Decimal                      @db.Decimal(5, 2)
  configuredSelfWeight             Decimal                      @db.Decimal(5, 2)
  configuredManagerWeight          Decimal                      @db.Decimal(5, 2)
  effectiveSelfWeight              Decimal                      @db.Decimal(5, 2)
  effectiveManagerWeight           Decimal                      @db.Decimal(5, 2)
  configuredCompetencyResultWeight Decimal?                     @db.Decimal(5, 2)
  configuredGoalsResultWeight      Decimal?                     @db.Decimal(5, 2)
  composition                      PerformanceResultComposition @default(COMPETENCY_ONLY)
  /// GoalCycle id used at calculate (traceability; no FK required for history).
  sourceGoalCycleId                String?                      @db.Uuid
  status                           PerformanceResultStatus      @default(CALCULATED)
  /// Org snapshot at calculate time (display authority). IDs without FK for history.
  areaIdSnapshot                   String?                      @db.Uuid
  areaNameSnapshot                 String?
  positionIdSnapshot               String?                      @db.Uuid
  positionNameSnapshot             String?
  businessUnitIdSnapshot           String?                      @db.Uuid
  businessUnitNameSnapshot         String?
  calculatedAt                     DateTime
  releasedAt                       DateTime?
  releasedByUserId                 String?                      @db.Uuid
  createdAt                        DateTime                     @default(now())
  updatedAt                        DateTime                     @updatedAt

  company       Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cycle         PerformanceCycle            @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  participant   PerformanceCycleParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  employee      Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  releasedBy    User?                       @relation("PerformanceResultReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict)
  goalSnapshots PerformanceResultGoal[]

  @@unique([participantId])
  @@index([companyId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([status])
  @@index([companyId, cycleId])
  @@index([cycleId, status])
  @@index([areaIdSnapshot])
  @@index([positionIdSnapshot])
  @@index([businessUnitIdSnapshot])
  @@index([composition])
  @@map("performance_results")
}

/// Historical Goals included in a PerformanceResult (09D). No FK to Goal/GoalResult.
model PerformanceResultGoal {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @db.Uuid
  performanceResultId   String   @db.Uuid
  sourceGoalId          String?  @db.Uuid
  sourceGoalResultId    String?  @db.Uuid
  goalTitle             String
  goalType              GoalType
  achievementPercentage Decimal  @db.Decimal(5, 2)
  configuredWeight      Decimal? @db.Decimal(5, 2)
  effectiveWeight       Decimal  @db.Decimal(5, 2)
  contribution          Decimal  @db.Decimal(5, 2)
  order                 Int      @default(0)
  createdAt             DateTime @default(now())

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  performanceResult PerformanceResult @relation(fields: [performanceResultId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([performanceResultId, order])
  @@map("performance_result_goals")
}

// ---------------------------------------------------------------------------
// Goals / OKRs — Core (09A): periods, goals, key results, assignments
// Independent of Performance. No progress/check-ins/scoring in 09A.
// ---------------------------------------------------------------------------

enum GoalCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

/// No TEAM: organization has no Team model. Scope via Employee / Area / Company.
enum GoalType {
  INDIVIDUAL
  AREA
  COMPANY
}

/// COMPLETED set only via approved GoalCompletionRequest (09C).
enum GoalStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GoalCompletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GoalMetricType {
  NUMBER
  PERCENTAGE
  CURRENCY
  BOOLEAN
}

enum GoalMetricDirection {
  INCREASE
  DECREASE
}

model GoalCycle {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @db.Uuid
  name            String
  description     String?
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  status          GoalCycleStatus @default(DRAFT)
  createdByUserId String          @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy         User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  goals             Goal[]
  performanceCycles PerformanceCycle[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([createdByUserId])
  @@map("goal_cycles")
}

/// GoalAssignment = explicit responsibility/assignment to an Employee (not mass materialization).
model Goal {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @db.Uuid
  cycleId         String     @db.Uuid
  title           String
  description     String?
  type            GoalType
  status          GoalStatus @default(DRAFT)
  /// Required when type=AREA; null for INDIVIDUAL/COMPANY.
  areaId          String?    @db.Uuid
  weight          Decimal?   @db.Decimal(5, 2)
  createdByUserId String     @db.Uuid
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cycle              GoalCycle               @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  area               Area?                   @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdBy          User                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  keyResults         GoalKeyResult[]
  assignments        GoalAssignment[]
  checkIns           GoalCheckIn[]
  completionRequests GoalCompletionRequest[]
  result             GoalResult?

  @@index([companyId])
  @@index([companyId, cycleId, status])
  @@index([companyId, type])
  @@index([areaId])
  @@index([cycleId])
  @@index([status])
  @@index([createdByUserId])
  @@map("goals")
}

model GoalAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  goalId     String   @db.Uuid
  employeeId String   @db.Uuid
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  goal     Goal     @relation(fields: [goalId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([goalId, employeeId])
  @@index([companyId])
  @@index([goalId])
  @@index([employeeId])
  @@map("goal_assignments")
}

model GoalKeyResult {
  id            String               @id @default(uuid()) @db.Uuid
  companyId     String               @db.Uuid
  goalId        String               @db.Uuid
  title         String
  description   String?
  metricType    GoalMetricType
  direction     GoalMetricDirection?
  startValue    Decimal?             @db.Decimal(18, 4)
  targetValue   Decimal?             @db.Decimal(18, 4)
  targetBoolean Boolean?
  unit          String?
  currencyCode  String?              @db.Char(3)
  weight        Decimal?             @db.Decimal(5, 2)
  order         Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  goal     Goal          @relation(fields: [goalId], references: [id], onDelete: Restrict)
  checkIns GoalCheckIn[]

  @@unique([goalId, order])
  @@index([companyId])
  @@index([goalId, order])
  @@map("goal_key_results")
}

/// Append-only progress event for a Key Result (09B). Latest = max(sequence).
/// No PATCH/DELETE. Corrections are new check-ins.
model GoalCheckIn {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @db.Uuid
  /// Denormalized for indexes/tenant filters; must match keyResult.goalId.
  goalId              String   @db.Uuid
  keyResultId         String   @db.Uuid
  /// Monotonic per KR; UNIQUE(keyResultId, sequence). Latest = max sequence.
  sequence            Int
  createdByUserId     String   @db.Uuid
  /// Optional Employee link when the actor has one; admins may omit.
  createdByEmployeeId String?  @db.Uuid
  numericValue        Decimal? @db.Decimal(18, 4)
  booleanValue        Boolean?
  comment             String?  @db.VarChar(2000)
  evidenceReference   String?  @db.VarChar(1000)
  createdAt           DateTime @default(now())

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  goal              Goal          @relation(fields: [goalId], references: [id], onDelete: Restrict)
  keyResult         GoalKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Restrict)
  createdBy         User          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByEmployee Employee?     @relation(fields: [createdByEmployeeId], references: [id], onDelete: Restrict)

  @@unique([keyResultId, sequence])
  @@index([companyId])
  @@index([goalId])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("goal_check_ins")
}

/// Formal close workflow (09C). Multiple historical requests allowed; only one PENDING.
model GoalCompletionRequest {
  id                    String                      @id @default(uuid()) @db.Uuid
  companyId             String                      @db.Uuid
  goalId                String                      @db.Uuid
  status                GoalCompletionRequestStatus @default(PENDING)
  requestedByUserId     String                      @db.Uuid
  requestedByEmployeeId String?                     @db.Uuid
  requestedAt           DateTime                    @default(now())
  requestComment        String?                     @db.VarChar(2000)
  reviewedByUserId      String?                     @db.Uuid
  reviewedAt            DateTime?
  reviewComment         String?                     @db.VarChar(2000)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  company             Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  goal                Goal        @relation(fields: [goalId], references: [id], onDelete: Restrict)
  requestedBy         User        @relation("GoalCompletionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  requestedByEmployee Employee?   @relation(fields: [requestedByEmployeeId], references: [id], onDelete: Restrict)
  reviewedBy          User?       @relation("GoalCompletionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  result              GoalResult?

  @@index([companyId, status])
  @@index([goalId, status])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@map("goal_completion_requests")
}

/// Immutable formal achievement result after APPROVED completion (09C).
/// Not a Performance score. Authority for historical reads after COMPLETED.
model GoalResult {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @db.Uuid
  goalId                String    @db.Uuid
  completionRequestId   String    @db.Uuid
  /// Formal achievement 0..100 (not progressPercentage, not Performance score).
  achievementPercentage Decimal   @db.Decimal(5, 2)
  /// Snapshot of Goal.weight at completion (used by Performance 09D aggregation across Goals).
  goalConfiguredWeight  Decimal?  @db.Decimal(5, 2)
  /// Snapshots at approval for historical Performance applicability (09D).
  goalTitleSnapshot     String?
  goalTypeSnapshot      GoalType?
  areaIdSnapshot        String?   @db.Uuid
  areaNameSnapshot      String?
  /// COMPANY goals apply to all employees; INDIVIDUAL/AREA use applicableEmployees.
  appliesCompanyWide    Boolean   @default(false)
  calculatedAt          DateTime
  completedAt           DateTime
  requestedByUserId     String    @db.Uuid
  approvedByUserId      String    @db.Uuid
  createdAt             DateTime  @default(now())

  company             Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  goal                Goal                           @relation(fields: [goalId], references: [id], onDelete: Restrict)
  completionRequest   GoalCompletionRequest          @relation(fields: [completionRequestId], references: [id], onDelete: Restrict)
  requestedBy         User                           @relation("GoalResultRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy          User                           @relation("GoalResultApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  keyResults          GoalResultKeyResult[]
  applicableEmployees GoalResultApplicableEmployee[]

  @@unique([goalId])
  @@unique([completionRequestId])
  @@index([companyId])
  @@index([appliesCompanyWide])
  @@map("goal_results")
}

/// Audience snapshot at GoalResult approval (09D). Avoids live Employee.areaId drift.
model GoalResultApplicableEmployee {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  goalResultId     String   @db.Uuid
  employeeId       String   @db.Uuid
  areaIdSnapshot   String?  @db.Uuid
  areaNameSnapshot String?
  createdAt        DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  goalResult GoalResult @relation(fields: [goalResultId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([goalResultId, employeeId])
  @@index([companyId])
  @@index([employeeId])
  @@index([goalResultId])
  @@map("goal_result_applicable_employees")
}

/// Historical KR snapshot for GoalResult. sourceKeyResultId is traceability only (no FK).
model GoalResultKeyResult {
  id                    String               @id @default(uuid()) @db.Uuid
  companyId             String               @db.Uuid
  goalResultId          String               @db.Uuid
  sourceKeyResultId     String?              @db.Uuid
  title                 String
  description           String?
  metricType            GoalMetricType
  direction             GoalMetricDirection?
  startNumericValue     Decimal?             @db.Decimal(18, 4)
  targetNumericValue    Decimal?             @db.Decimal(18, 4)
  targetBoolean         Boolean?
  finalNumericValue     Decimal?             @db.Decimal(18, 4)
  finalBooleanValue     Boolean?
  unit                  String?
  currencyCode          String?              @db.Char(3)
  configuredWeight      Decimal?             @db.Decimal(5, 2)
  effectiveWeight       Decimal?             @db.Decimal(5, 2)
  achievementPercentage Decimal              @db.Decimal(5, 2)
  order                 Int                  @default(0)
  createdAt             DateTime             @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  goalResult GoalResult @relation(fields: [goalResultId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([goalResultId, order])
  @@map("goal_result_key_results")
}
