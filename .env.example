# =============================================================================
# DEV example (local pnpm + infrastructure/docker-compose.yml on port 5433)
# =============================================================================
DATABASE_URL=postgresql://talento:talento@localhost:5433/talento?schema=public
PORT=3001
NODE_ENV=development

JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3000

# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# TRUST_PROXY=1
# JSON_BODY_LIMIT=1mb

# Observability (Fase 12)
# LOG_LEVEL=info
# LOG_FORMAT=json          # default json when NODE_ENV=production
# SLOW_REQUEST_MS=1000
# METRICS_ENABLED=true     # GET /metrics (keep private / proxy-deny in prod)

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STT_LANGUAGE=es-CO

# DEV seed only — forbidden when NODE_ENV=production
DEV_OWNER_EMAIL=owner@talento.local
DEV_OWNER_PASSWORD=ChangeMeOwner123!
DEV_ADMIN_EMAIL=admin@talento.local
DEV_ADMIN_PASSWORD=ChangeMeAdmin123!

# =============================================================================
# PRODUCTION requirements (see also infrastructure/.env.prod.example)
# =============================================================================
# - NODE_ENV=production
# - Strong distinct JWT secrets (≥32 chars, not DEV values)
# - CORS_ORIGINS = exact browser origins (no *)
# - DATABASE_URL to private Postgres (not public internet)
# - COOKIE_SECURE=true; SameSite per topology (none if cross-origin)
# - TRUST_PROXY=1 behind a single reverse proxy
# - NEXT_PUBLIC_API_URL baked into web image at build time
# - Use: pnpm db:migrate:deploy (never migrate dev)
# - Never auto-run db:seed:dev / db:seed:qa
# Rotate any secrets that ever lived in a historically tracked .env.
# Docs: docs/security.md · docs/production-infrastructure.md
