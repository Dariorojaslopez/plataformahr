DATABASE_URL=postgresql://talento:talento@localhost:5433/talento?schema=public
PORT=3001
NODE_ENV=development

# Production: ≥32 chars, distinct, never reuse DEV values or known defaults.
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated. Production: required, no wildcards.
CORS_ORIGINS=http://localhost:3000

# Refresh cookie (HttpOnly). Cross-origin SPA needs SameSite=none + Secure.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# JSON_BODY_LIMIT=1mb

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Browser STT (apps/web) — BCP-47 language tag
NEXT_PUBLIC_STT_LANGUAGE=es-CO

# DEV seed only (pnpm db:seed:dev). Forbidden in production.
DEV_OWNER_EMAIL=owner@talento.local
DEV_OWNER_PASSWORD=ChangeMeOwner123!
DEV_ADMIN_EMAIL=admin@talento.local
DEV_ADMIN_PASSWORD=ChangeMeAdmin123!

# Before production: rotate any secrets that ever lived in a historically tracked .env.
# See docs/security.md.
